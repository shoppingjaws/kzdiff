{
	"name": "kzdiff",
	"version": "1.7.1",
	"description": "CLI tool for comparing Kustomize build results between branches",
	"keywords": [
		"kustomize",
		"kubernetes",
		"diff",
		"k8s",
		"gitops"
	],
	"author": "shoppingjaws",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/shoppingjaws/kzdiff"
	},
	"homepage": "https://github.com/shoppingjaws/kzdiff#readme",
	"bugs": {
		"url": "https://github.com/shoppingjaws/kzdiff/issues"
	},
	"type": "module",
	"exports": "./src/cli.ts",
	"bin": {
		"kzdiff": "./src/cli.ts"
	},
	"files": [
		"src/",
		"LICENSE",
		"README.md",
		"package.json",
		"tsconfig.json"
	],
	"scripts": {
		"test": "bun test",
		"test:cli": "bun test cli.test.ts",
		"test:unit": "bun test --ignore cli.test.ts",
		"test:yaml": "bun test src/yaml-diff/index.test.ts",
		"build": "bun build ./src/cli.ts --compile --outfile kzdiff",
		"format": "biome format --write",
		"format:check": "biome format",
		"lint": "biome lint --fix",
		"lint:check": "biome lint",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"js-yaml": "^4.1.0",
		"jsonpath-plus": "^10.2.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/js-yaml": "^4.0.9",
		"typescript": "^5.9.2"
	}
}
