{
	"permissions": {
		"allow": [
			"Bash(biome lint --fix)",
			"Bash(tsc --noEmit)",
			"Bash(biome lint)",
			"Bash(biome format --write)",
			"Bash(dyff)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit(*.ts)",
				"hooks": [
					{
						"type": "command",
						"command": "bun run format"
					},
					{
						"type": "command",
						"command": "bun run lint"
					},
					{
						"type": "command",
						"command": "bun run typecheck"
					}
				]
			},
			{
				"matcher": "MultiEdit(*.ts)",
				"hooks": [
					{
						"type": "command",
						"command": "bun run format"
					},
					{
						"type": "command",
						"command": "bun run lint"
					},
					{
						"type": "command",
						"command": "bun run typecheck"
					}
				]
			},
			{
				"matcher": "Write(*.ts)",
				"hooks": [
					{
						"type": "command",
						"command": "bun run format"
					},
					{
						"type": "command",
						"command": "bun run lint"
					},
					{
						"type": "command",
						"command": "bun run typecheck"
					}
				]
			}
		]
	}
}
