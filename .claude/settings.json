{
	"permissions": {
		"allow": [
			"Bash(bun test:*)",
			"Bash(bun typecheck)",
			"Bash(bun lint:check)",
			"Bash(bun lint)",
			"Bash(bun format)",
			"Bash(bun format:check)",
			"Bash(dyff)"
		],
		"deny": ["Edit(package.json)"]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit(*.ts)",
				"hooks": [
					{
						"type": "command",
						"command": "bun run format"
					},
					{
						"type": "command",
						"command": "bun run lint"
					},
					{
						"type": "command",
						"command": "bun run typecheck"
					}
				]
			},
			{
				"matcher": "MultiEdit(*.ts)",
				"hooks": [
					{
						"type": "command",
						"command": "bun run format"
					},
					{
						"type": "command",
						"command": "bun run lint"
					},
					{
						"type": "command",
						"command": "bun run typecheck"
					}
				]
			},
			{
				"matcher": "Write(*.ts)",
				"hooks": [
					{
						"type": "command",
						"command": "bun run format"
					},
					{
						"type": "command",
						"command": "bun run lint"
					},
					{
						"type": "command",
						"command": "bun run typecheck"
					}
				]
			}
		]
	}
}
